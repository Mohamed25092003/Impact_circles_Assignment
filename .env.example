DATABASE_URL=postgresql+psycopg2://impact:replace_with_database_password@localhost:5434/impact_circle
UPLOAD_DIR=./src/uploads
OCR_LANGUAGES=eng+ara
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MAX_PDF_MB=50
MAX_DOCUMENT_PAGES=500
MAX_EXTRACTED_CHARACTERS=5000000
GROQ_BATCH_CHARACTERS=12000

# Part 2: set a random secret in the actual .env; authorize in Swagger with it.
CONTENT_REVIEWER_TOKEN=
CONTENT_PUBLISH_URL=http://127.0.0.1:8000/api/mock-publisher
CONTENT_PUBLIC_URL=http://localhost:8000

# Same database password used by DATABASE_URL; keep the real value private.
POSTGRES_PASSWORD=replace_with_database_password
